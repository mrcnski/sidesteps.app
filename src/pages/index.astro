---
import DrawStage from '../components/DrawStage.astro';
import Icon from '../components/Icon.astro';
import RecentDraws from '../components/RecentDraws.astro';
import SuitGlyph from '../components/SuitGlyph.astro';
import Base from '../layouts/Base.astro';

import { CUE_COUNT, cuesInSuit } from '../data/cues';
import { SUIT_IDS, SUITS } from '../data/suits';

const STEPS = [
  {
    title: 'Name the problem',
    body: 'A sentence is enough. Writing it down already does half the work.',
  },
  {
    title: 'Draw a card',
    body: 'Each card is a short, deliberately vague nudge in some direction.',
  },
  {
    title: 'Hold it up to the problem',
    body: 'Take whichever reading moves you. If nothing fits, draw again.',
  },
];
---

<Base>
  <section class="container-page grid items-center gap-x-20 gap-y-14 pt-8 pb-20 sm:pt-14 lg:grid-cols-[minmax(0,1fr)_auto] lg:pt-20 lg:pb-28">
    <div class="max-w-xl">
      <p class="eyebrow">A deck of {CUE_COUNT} cues for getting unstuck</p>
      <h1 class="mt-5 font-display text-[clamp(2.75rem,7vw,4.75rem)] leading-[0.98] font-[640] tracking-[-0.025em] text-balance">
        When you’re stuck, take a <span class="marker">sidestep</span>.
      </h1>
      <p class="mt-7 max-w-md text-lg leading-relaxed text-pretty text-ink-soft">
        Hard problems rarely give way to staring harder. Draw a card, hold it up
        against what you’re working on, and see what moves.
      </p>

      <form class="mt-10 max-w-md" data-draw-form>
        <label
          for="problem"
          class="flex items-baseline justify-between text-sm"
        >
          <span class="font-medium text-ink">What are you stuck on?</span>
          <span class="text-ink-faint">Optional</span>
        </label>
        <input
          id="problem"
          class="input mt-2.5"
          placeholder="e.g. Picking a name for my project"
          maxlength="140"
          autocomplete="off"
          enterkeyhint="go"
          data-problem
        />
        <div class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-3">
          <button type="submit" class="btn btn-primary btn-lg">
            <Icon name="redo" />
            <span data-draw-label>Draw a card</span>
          </button>
          <span class="text-sm text-ink-faint max-sm:hidden">
            or press <kbd>Space</kbd>
          </span>
        </div>
      </form>
    </div>

    <div class="lg:pr-6">
      <DrawStage />
    </div>
  </section>

  <RecentDraws />

  <section class="container-page mt-20 sm:mt-28" aria-labelledby="how-title">
    <div class="grid gap-12 lg:grid-cols-[18rem_1fr] lg:gap-20">
      <div>
        <p class="eyebrow">How it works</p>
        <h2
          id="how-title"
          class="mt-4 font-display text-4xl leading-tight font-[620] tracking-tight text-balance"
        >
          A nudge, not an answer.
        </h2>
      </div>
      <ol class="grid gap-10 sm:grid-cols-3 sm:gap-8">
        {STEPS.map((step, i) => (
          <li class="border-t border-line-strong pt-5">
            <span class="font-mono text-sm font-medium text-accent tabular-nums">
              0{i + 1}
            </span>
            <h3 class="mt-3 text-lg font-semibold tracking-tight">
              {step.title}
            </h3>
            <p class="mt-2 leading-relaxed text-pretty text-ink-soft">
              {step.body}
            </p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="container-page mt-24 sm:mt-32" aria-labelledby="suits-title">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div>
        <p class="eyebrow">Seven suits</p>
        <h2
          id="suits-title"
          class="mt-4 font-display text-4xl leading-tight font-[620] tracking-tight"
        >
          Different ways to move.
        </h2>
      </div>
      <a href="/deck/" class="btn btn-secondary">
        Browse the whole deck
        <Icon name="arrowRight" />
      </a>
    </div>

    <ul class="mt-10 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      {SUIT_IDS.map((id) => (
        <li>
          <a
            href={`/deck/#${id}`}
            class="group flex h-full items-start gap-4 rounded-2xl border border-line bg-surface p-5 shadow-card-sm transition duration-300 ease-out-soft hover:-translate-y-0.5 hover:border-line-strong"
            data-suit={id}
          >
            <span class="grid size-10 shrink-0 place-items-center rounded-xl bg-[color-mix(in_srgb,var(--suit)_12%,transparent)] text-suit">
              <SuitGlyph suit={id} class="size-4.5" />
            </span>
            <span>
              <span class="flex items-baseline gap-2">
                <span class="font-semibold">{SUITS[id].name}</span>
                <span class="text-xs text-ink-faint tabular-nums">
                  {cuesInSuit(id).length}
                </span>
              </span>
              <span class="mt-1 block text-sm leading-snug text-ink-soft">
                {SUITS[id].description}
              </span>
            </span>
          </a>
        </li>
      ))}
      <li class="max-lg:hidden">
        <a
          href="/about/"
          class="flex h-full flex-col justify-between rounded-2xl border border-dashed border-line-strong p-5 text-sm text-ink-soft transition-colors hover:text-ink"
        >
          <span class="leading-snug">
            Inspired by Brian Eno and Peter Schmidt’s{' '}
            <em>Oblique Strategies</em>.
          </span>
          <span class="mt-4 font-medium">About the deck &rarr;</span>
        </a>
      </li>
    </ul>
  </section>
</Base>

<script>
  import { initDraw } from '../scripts/draw';

  initDraw();
</script>
