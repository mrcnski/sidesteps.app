---
import CardFace from '../../components/CardFace.astro';
import CueActions from '../../components/CueActions.astro';
import Icon from '../../components/Icon.astro';
import MiniCard from '../../components/MiniCard.astro';
import SuitGlyph from '../../components/SuitGlyph.astro';
import Base from '../../layouts/Base.astro';

import { CUES, cuesInSuit, type Cue } from '../../data/cues';
import { SUITS } from '../../data/suits';

export function getStaticPaths() {
  return CUES.map((cue) => ({ params: { slug: cue.slug }, props: { cue } }));
}

interface Props {
  cue: Cue;
}

const { cue } = Astro.props;
const index = CUES.indexOf(cue);
const prev = CUES[(index - 1 + CUES.length) % CUES.length];
const next = CUES[(index + 1) % CUES.length];
const suit = SUITS[cue.suit];

// A few others from the same suit, starting after this one so each page
// shows a different selection.
const sameSuit = cuesInSuit(cue.suit);
const at = sameSuit.indexOf(cue);
const related = [...sameSuit.slice(at + 1), ...sameSuit.slice(0, at)].slice(
  0,
  4,
);
---

<Base title={cue.text} description={`${cue.text}. ${cue.note}`}>
  <section class="container-page grid items-center gap-x-20 gap-y-14 pt-8 sm:pt-14 lg:grid-cols-[auto_minmax(0,1fr)]">
    <div class="mx-auto w-[min(100%,20rem)] sm:w-88" data-cue-id={cue.id}>
      <CardFace cue={cue} heading="h1" />
      <CueActions keep={false} class="mt-6 justify-center" />
    </div>

    <div class="mx-auto w-full max-w-lg lg:mx-0" data-suit={cue.suit}>
      <p class="flex items-center gap-2 text-sm text-ink-soft">
        <SuitGlyph suit={cue.suit} class="size-3.5 text-suit" />
        <span>
          {`Card ${cue.id} of ${CUES.length} · `}
          <a href={`/deck/#${cue.suit}`} class="link">
            {suit.name}
          </a>
        </span>
      </p>
      <h2 class="mt-4 font-display text-[2rem] leading-tight font-[620] tracking-tight text-balance">
        Hold it up to your problem.
      </h2>
      <p class="mt-3 leading-relaxed text-pretty text-ink-soft">
        {suit.name} cards: {suit.description.toLowerCase()} Take the first
        reading that moves you, and write it down before it slips away.
      </p>

      <form class="mt-8 space-y-5" data-apply-form>
        <div>
          <label for="problem" class="text-sm font-medium">
            What are you stuck on?
          </label>
          <input
            id="problem"
            class="input mt-2"
            placeholder="e.g. Picking a name for my project"
            maxlength="140"
            autocomplete="off"
            data-problem
          />
        </div>
        <div>
          <label for="note" class="text-sm font-medium">
            What does this card suggest?
          </label>
          <textarea
            id="note"
            rows="3"
            class="input mt-2 h-auto resize-none py-3 leading-relaxed"
            placeholder="A thought, a next step, a question…"
            data-note
          ></textarea>
        </div>
        <div class="flex flex-wrap items-center gap-3 pt-1">
          <button type="submit" class="btn btn-primary">
            <Icon name="bookmark" />
            Save to notebook
          </button>
          <a href="/?draw" class="btn btn-ghost">
            <Icon name="redo" />
            Draw a random card
          </a>
        </div>
        <p class="hidden items-center gap-2 text-sm text-ink-soft" data-saved>
          <Icon name="check" class="size-4 text-accent" />
          <span>
            Saved.{' '}
            <a href="/notebook/" class="link">
              Open your notebook
            </a>
          </span>
        </p>
      </form>

      <nav
        class="mt-12 flex items-center justify-between gap-4 border-t border-line pt-6 text-sm"
        aria-label="Neighbouring cards"
      >
        <a
          href={`/cue/${prev.slug}/`}
          class="group flex min-w-0 items-center gap-2 text-ink-soft hover:text-ink"
          rel="prev"
        >
          <Icon
            name="arrowLeft"
            class="size-4 shrink-0 transition-transform group-hover:-translate-x-0.5"
          />
          <span class="truncate">{prev.text}</span>
        </a>
        <a
          href={`/cue/${next.slug}/`}
          class="group flex min-w-0 items-center gap-2 text-right text-ink-soft hover:text-ink"
          rel="next"
        >
          <span class="truncate">{next.text}</span>
          <Icon
            name="arrowRight"
            class="size-4 shrink-0 transition-transform group-hover:translate-x-0.5"
          />
        </a>
      </nav>
    </div>
  </section>

  {related.length > 0 && (
    <section class="container-page mt-24" aria-labelledby="related-title">
      <h2 id="related-title" class="eyebrow">
        More from {suit.name}
      </h2>
      <ul class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {related.map((other) => (
          <li>
            <MiniCard cue={other} />
          </li>
        ))}
      </ul>
    </section>
  )}
</Base>

<script>
  import {
    bindCueActions,
    notifyNotebookChange,
  } from '../../scripts/cueActions';
  import { addToNotebook, getProblem, setProblem } from '../../utils/storage';

  const root = document.querySelector<HTMLElement>('[data-cue-id]')!;
  const form = document.querySelector<HTMLFormElement>('[data-apply-form]')!;
  const problem = form.querySelector<HTMLInputElement>('[data-problem]')!;
  const note = form.querySelector<HTMLTextAreaElement>('[data-note]')!;
  const saved = form.querySelector<HTMLElement>('[data-saved]')!;

  bindCueActions(root);

  problem.value = getProblem();
  problem.addEventListener('input', () => setProblem(problem.value));

  form.addEventListener('submit', (event) => {
    event.preventDefault();
    addToNotebook(Number(root.dataset.cueId), problem.value, note.value);
    notifyNotebookChange();
    note.value = '';
    saved.classList.replace('hidden', 'flex');
  });
</script>
