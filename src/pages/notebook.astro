---
import CardBack from '../components/CardBack.astro';
import Icon from '../components/Icon.astro';
import PageHeader from '../components/PageHeader.astro';
import Base from '../layouts/Base.astro';
---

<Base
  title="Notebook"
  description="The cards you’ve kept, and your notes on them."
>
  <section class="container-page pt-10 sm:pt-16">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <PageHeader eyebrow="Your notebook" title="Kept cards">
        Cards you’ve kept, grouped by what you were stuck on. Jot down what each
        one made you think of.
      </PageHeader>
      <div class="hidden gap-2" data-toolbar>
        <button type="button" class="btn btn-secondary btn-sm" data-export>
          <Icon name="copy" />
          <span data-export-label>Copy as Markdown</span>
        </button>
        <button type="button" class="btn btn-ghost btn-sm" data-clear>
          Clear all
        </button>
      </div>
    </div>

    <div class="mt-12 space-y-16" data-groups></div>

    <div class="hidden flex-col items-center py-16 text-center" data-empty>
      <div class="relative h-40 w-44" aria-hidden="true">
        <CardBack class="absolute top-2 left-4 w-24 -rotate-12" />
        <CardBack class="absolute top-0 left-10 w-24 rotate-[4deg]" />
        <CardBack class="absolute top-3 left-16 w-24 rotate-[16deg]" />
      </div>
      <h2 class="mt-8 font-display text-3xl font-[620] tracking-tight">
        Nothing kept yet
      </h2>
      <p class="mt-3 max-w-sm text-pretty text-ink-soft">
        When a card strikes a chord, press <em>Keep in notebook</em> and it will
        show up here, ready for your notes.
      </p>
      <a href="/?draw" class="btn btn-primary mt-8">
        <Icon name="redo" />
        Draw a card
      </a>
    </div>

    <p class="mt-20 text-center text-sm text-ink-faint">
      Your notebook is stored only in this browser. Nothing is sent anywhere.
    </p>
  </section>

  <template data-group-template>
    <section>
      <div class="flex items-baseline gap-3 border-b border-line pb-3">
        <h2
          class="font-display text-2xl font-[600] tracking-tight text-balance"
          data-group-title
        ></h2>
        <span
          class="text-sm text-ink-faint tabular-nums"
          data-group-count
        ></span>
      </div>
      <ul class="mt-6 grid gap-4 lg:grid-cols-2" data-group-list></ul>
    </section>
  </template>

  <template data-entry-template>
    <li
      class="grain flex flex-col rounded-2xl border border-line bg-surface p-5 shadow-card-sm sm:p-6"
      data-entry
    >
      <div class="flex items-center justify-between gap-4">
        <span class="flex items-center gap-2 text-[0.6875rem] font-mono font-medium tracking-[0.08em] text-suit uppercase">
          <svg class="size-3 fill-current" aria-hidden="true">
            <use></use>
          </svg>
          <span data-entry-meta></span>
        </span>
        <span class="flex items-center gap-1">
          <time class="text-xs text-ink-faint" data-entry-date></time>
          <button
            type="button"
            class="grid size-8 place-items-center rounded-full text-ink-faint transition-colors hover:bg-paper-deep hover:text-ink"
            aria-label="Remove from notebook"
            data-entry-remove
          >
            <Icon name="trash" class="size-4" />
          </button>
        </span>
      </div>
      <a
        class="mt-3 self-start font-display text-2xl leading-tight font-[600] tracking-[-0.01em] hover:text-accent"
        data-entry-link
      ></a>
      <p
        class="mt-1.5 text-sm leading-relaxed text-ink-soft"
        data-entry-note
      ></p>
      <label class="mt-4 block">
        <span class="sr-only">Your note</span>
        <textarea
          rows="1"
          class="block w-full resize-none rounded-xl border border-transparent bg-paper/70 px-3.5 py-2.5 text-[0.9375rem] leading-relaxed text-ink transition-colors placeholder:text-ink-faint hover:border-line focus:border-accent focus:bg-surface focus:outline-none"
          placeholder="What does this make you think of?"
          data-entry-input
        ></textarea>
      </label>
    </li>
  </template>
</Base>

<script>
  import { CUES } from '../data/cues';
  import { SUITS } from '../data/suits';
  import { notifyNotebookChange } from '../scripts/cueActions';
  import { groupByProblem, notebookToMarkdown } from '../utils/notebook';
  import { getNotebook, setNotebook } from '../utils/storage';

  const groupsEl = document.querySelector<HTMLElement>('[data-groups]')!;
  const emptyEl = document.querySelector<HTMLElement>('[data-empty]')!;
  const toolbar = document.querySelector<HTMLElement>('[data-toolbar]')!;
  const groupTemplate = document.querySelector<HTMLTemplateElement>(
    '[data-group-template]',
  )!;
  const entryTemplate = document.querySelector<HTMLTemplateElement>(
    '[data-entry-template]',
  )!;

  const dateFormat = new Intl.DateTimeFormat(undefined, {
    month: 'short',
    day: 'numeric',
  });

  const autoGrow = (textarea: HTMLTextAreaElement) => {
    textarea.style.height = 'auto';
    textarea.style.height = `${textarea.scrollHeight + 2}px`;
  };

  function updateEntry(key: string, note: string) {
    setNotebook(
      getNotebook().map((entry) =>
        entry.key === key ? { ...entry, note } : entry,
      ),
    );
  }

  function removeEntry(key: string) {
    setNotebook(getNotebook().filter((entry) => entry.key !== key));
    notifyNotebookChange();
    render();
  }

  function render() {
    const entries = getNotebook();
    const isEmpty = entries.length === 0;
    emptyEl.classList.toggle('hidden', !isEmpty);
    emptyEl.classList.toggle('flex', isEmpty);
    toolbar.classList.toggle('hidden', isEmpty);
    toolbar.classList.toggle('flex', !isEmpty);

    groupsEl.replaceChildren(
      ...groupByProblem(entries).map((group) => {
        const groupEl = groupTemplate.content.cloneNode(
          true,
        ) as DocumentFragment;
        groupEl.querySelector('[data-group-title]')!.textContent =
          group.problem || 'Untitled problem';
        groupEl.querySelector('[data-group-count]')!.textContent =
          `${group.entries.length} ${group.entries.length === 1 ? 'card' : 'cards'}`;
        const list = groupEl.querySelector('[data-group-list]')!;

        for (const entry of group.entries) {
          const cue = CUES.find((c) => c.id === entry.cueId);
          if (!cue) continue;
          const el = entryTemplate.content.cloneNode(true) as DocumentFragment;
          const li = el.querySelector<HTMLElement>('[data-entry]')!;
          li.dataset.suit = cue.suit;
          el.querySelector('use')!.setAttribute('href', `#glyph-${cue.suit}`);
          el.querySelector('[data-entry-meta]')!.textContent =
            `${SUITS[cue.suit].name} · ${String(cue.id).padStart(2, '0')}`;
          const time = el.querySelector<HTMLTimeElement>('[data-entry-date]')!;
          time.dateTime = entry.createdAt;
          time.textContent = dateFormat.format(new Date(entry.createdAt));
          const link =
            el.querySelector<HTMLAnchorElement>('[data-entry-link]')!;
          link.href = `/cue/${cue.slug}/`;
          link.textContent = cue.text;
          el.querySelector('[data-entry-note]')!.textContent = cue.note;

          const input =
            el.querySelector<HTMLTextAreaElement>('[data-entry-input]')!;
          input.value = entry.note;
          input.addEventListener('input', () => {
            autoGrow(input);
            updateEntry(entry.key, input.value);
          });
          el.querySelector('[data-entry-remove]')!.addEventListener(
            'click',
            () => removeEntry(entry.key),
          );
          list.append(el);
        }
        return groupEl;
      }),
    );

    groupsEl
      .querySelectorAll<HTMLTextAreaElement>('[data-entry-input]')
      .forEach(autoGrow);
  }

  document
    .querySelector('[data-export]')!
    .addEventListener('click', async () => {
      const label = document.querySelector<HTMLElement>('[data-export-label]')!;
      const markdown = notebookToMarkdown(
        getNotebook(),
        (id) => CUES.find((c) => c.id === id)?.text ?? `Card ${id}`,
      );
      try {
        await navigator.clipboard.writeText(markdown);
        label.textContent = 'Copied';
      } catch {
        label.textContent = 'Couldn’t copy';
      }
      setTimeout(() => (label.textContent = 'Copy as Markdown'), 1800);
    });

  document.querySelector('[data-clear]')!.addEventListener('click', () => {
    if (!confirm('Remove every card from your notebook? This can’t be undone.'))
      return;
    setNotebook([]);
    notifyNotebookChange();
    render();
  });

  render();
</script>
