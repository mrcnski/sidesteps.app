---
import SuitGlyph from './SuitGlyph.astro';

import type { SuitId } from '../data/suits';

interface Props {
  id: number;
  suit: SuitId;
  class?: string;
}

const { id, suit, class: className } = Astro.props;
---

<div
  class:list={['flex flex-col items-center gap-1 text-suit', className]}
  aria-hidden="true"
>
  <span
    class="font-mono text-[max(0.8125rem,4.4cqi)] leading-none font-medium tabular-nums"
    data-cue-num
  >
    {String(id).padStart(2, '0')}
  </span>
  <SuitGlyph suit={suit} class="size-[max(0.75rem,3.6cqi)]" />
</div>
