---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={['@container', className]} aria-hidden="true">
  <div class="card-back relative aspect-5/7 w-full overflow-hidden rounded-[clamp(0.875rem,5cqi,1.375rem)] bg-back shadow-card">
    <div class="card-back-frame absolute inset-[4.5cqi] rounded-[3cqi]"></div>
    <div class="absolute inset-0 grid place-items-center">
      <div class="card-back-medallion grid size-[34cqi] place-items-center rounded-full">
        <span class="font-serif text-[17cqi] leading-none font-medium text-back-line italic">
          S
        </span>
      </div>
    </div>
  </div>
</div>

<style>
  .card-back {
    box-shadow:
      inset 0 0 0 1px color-mix(in srgb, var(--back-line) 18%, transparent),
      var(--card-shadow);
    background-image:
      radial-gradient(
        ellipse at 50% 40%,
        color-mix(in srgb, var(--back-line) 10%, transparent),
        transparent 70%
      ),
      linear-gradient(160deg, var(--back), var(--back-deep));
  }

  .card-back-frame {
    border: 1px solid color-mix(in srgb, var(--back-line) 55%, transparent);
    background-image:
      repeating-linear-gradient(
        45deg,
        color-mix(in srgb, var(--back-line) 16%, transparent) 0 1px,
        transparent 1px 11px
      ),
      repeating-linear-gradient(
        -45deg,
        color-mix(in srgb, var(--back-line) 16%, transparent) 0 1px,
        transparent 1px 11px
      );
    box-shadow: inset 0 0 0 4px var(--back-deep);
    mask-image: radial-gradient(
      circle at 50% 50%,
      transparent 19cqi,
      #000 19.5cqi
    );
  }

  .card-back-medallion {
    border: 1px solid color-mix(in srgb, var(--back-line) 70%, transparent);
    box-shadow:
      0 0 0 5px var(--back),
      0 0 0 6px color-mix(in srgb, var(--back-line) 30%, transparent);
  }
</style>
