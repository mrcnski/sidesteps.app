---
import CardIndex from './CardIndex.astro';

import type { Cue } from '../data/cues';
import { SUITS } from '../data/suits';

interface Props {
  cue: Cue;
  heading?: 'h1' | 'h2' | 'p';
  /** Use a lighter shadow, e.g. for cards laid out in a grid. */
  flat?: boolean;
  class?: string;
}

const {
  cue,
  heading: Heading = 'p',
  flat = false,
  class: className,
} = Astro.props;
---

<div class:list={['@container', className]}>
  <article
    class:list={[
      'grain flex aspect-5/7 w-full flex-col rounded-[clamp(0.75rem,5cqi,1.375rem)] border border-card-edge bg-card-face p-[7cqi]',
      flat ? 'shadow-card-sm' : 'shadow-card',
    ]}
    data-suit={cue.suit}
    data-card-face
  >
    <div class="flex items-start justify-between">
      <CardIndex id={cue.id} suit={cue.suit} />
      <span
        class="font-mono text-[max(0.5625rem,3cqi)] font-medium tracking-[0.08em] text-suit uppercase"
        data-cue-suit-name
      >
        {SUITS[cue.suit].name}
      </span>
    </div>

    <div class="flex flex-1 items-center justify-center px-[2cqi]">
      <Heading
        class="text-center font-display text-[max(1.25rem,12cqi)] leading-[1.02] font-[620] tracking-[-0.025em] text-balance text-card-text"
        data-cue-text
      >
        {cue.text}
      </Heading>
    </div>

    <CardIndex id={cue.id} suit={cue.suit} class="self-end rotate-180" />
  </article>
</div>
