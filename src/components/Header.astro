---
import Logo from './Logo.astro';

const NAV = [
  { href: '/', label: 'Draw' },
  { href: '/deck/', label: 'Deck' },
  { href: '/notebook/', label: 'Notebook' },
  { href: '/about/', label: 'About' },
];

const path = Astro.url.pathname.replace(/\/?$/, '/');
const isActive = (href: string) =>
  href === '/'
    ? path === '/'
    : path.startsWith(href) || (href === '/deck/' && path.startsWith('/cue/'));
---

<header class="relative z-20">
  <div class="container-page flex h-18 items-center justify-between gap-4">
    <a
      href="/"
      class="group flex items-center gap-2.5 rounded-md"
      aria-label="Sidesteps home"
    >
      <Logo class="size-8 transition-transform duration-300 ease-out-soft group-hover:-rotate-6" />
      <span class="font-serif text-[1.375rem] font-semibold tracking-tight text-ink">
        Sidesteps
      </span>
    </a>
    <nav aria-label="Main">
      <ul class="flex items-center gap-0.5 text-[0.9375rem] sm:gap-1">
        {NAV.map(({ href, label }) => (
          <li class:list={[href === '/' && 'max-sm:hidden']}>
            <a
              href={href}
              class:list={[
                'relative flex items-center gap-1.5 rounded-full px-2.5 py-1.5 font-medium transition-colors sm:px-3.5',
                isActive(href)
                  ? 'bg-paper-deep text-ink'
                  : 'text-ink-soft hover:text-ink',
              ]}
              aria-current={isActive(href) ? 'page' : undefined}
            >
              {label}
              {href === '/notebook/' && (
                <span
                  class="hidden min-w-5 rounded-full bg-accent px-1.5 text-center text-[0.6875rem] leading-5 font-semibold text-accent-ink tabular-nums"
                  data-notebook-count
                />
              )}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<script>
  import { getNotebook } from '../utils/storage';

  function renderCount() {
    const badge = document.querySelector<HTMLElement>('[data-notebook-count]');
    if (!badge) return;
    const count = getNotebook().length;
    badge.textContent = String(count);
    badge.classList.toggle('hidden', count === 0);
  }

  renderCount();
  document.addEventListener('notebook:change', renderCount);
  window.addEventListener('storage', renderCount);
</script>
