---
import CardFace from './CardFace.astro';

import type { Cue } from '../data/cues';

interface Props {
  cue: Cue;
}

const { cue } = Astro.props;
---

<a
  href={`/cue/${cue.slug}/`}
  class="group block rounded-[1rem] transition duration-300 ease-out-soft hover:-translate-y-1 hover:-rotate-1"
>
  <CardFace cue={cue} flat class="transition-shadow" />
</a>
