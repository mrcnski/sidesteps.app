---
/** Small stroke icons used in buttons. */
const PATHS = {
  bookmark: 'M6.5 4.5h11v15l-5.5-4-5.5 4z',
  check: 'm5 12.5 4.5 4.5L19 7.5',
  link: 'M10 14a4 4 0 0 0 5.66 0l3-3a4 4 0 0 0-5.66-5.66l-1 1M14 10a4 4 0 0 0-5.66 0l-3 3a4 4 0 0 0 5.66 5.66l1-1',
  redo: 'M19.5 12a7.5 7.5 0 1 1-2.2-5.3M19.5 4.5v4h-4',
  arrowLeft: 'M19 12H5m6-6-6 6 6 6',
  arrowRight: 'M5 12h14m-6-6 6 6-6 6',
  copy: 'M9 9h10v10H9zM5 15V5h10',
  trash: 'M4.5 7h15M9.5 7V4.5h5V7m3 0-.8 12.5h-9.4L6.5 7',
  sun: 'M12 8.25a3.75 3.75 0 1 0 0 7.5 3.75 3.75 0 0 0 0-7.5ZM12 3v1.5m0 15V21M3 12h1.5m15 0H21M5.64 5.64l1.06 1.06m10.6 10.6 1.06 1.06M5.64 18.36l1.06-1.06m10.6-10.6 1.06-1.06',
  moon: 'M19.5 14.25A7.5 7.5 0 0 1 9.75 4.5a7.5 7.5 0 1 0 9.75 9.75Z',
} as const;

export type IconName = keyof typeof PATHS;

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className } = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
>
  <path d={PATHS[name]}></path>
</svg>
