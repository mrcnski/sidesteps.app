---
/** Client-rendered list of recently drawn cues. Hidden until there are any. */
---

<section
  class="container-page hidden"
  data-recent
  aria-labelledby="recent-title"
>
  <div class="flex items-baseline justify-between gap-4 border-t border-line pt-8">
    <h2 id="recent-title" class="eyebrow">
      Recently drawn
    </h2>
    <a href="/notebook/" class="text-sm text-ink-soft hover:text-ink">
      Open notebook &rarr;
    </a>
  </div>
  <ul class="mt-5 flex flex-wrap gap-2" data-recent-list></ul>
  <template data-recent-item>
    <li>
      <a class="flex items-center gap-2 rounded-full border border-line bg-surface py-1.5 pr-3.5 pl-3 text-sm text-ink-soft shadow-card-sm transition-colors hover:border-line-strong hover:text-ink">
        <svg class="size-3 shrink-0 fill-current text-suit" aria-hidden="true">
          <use></use>
        </svg>
        <span></span>
      </a>
    </li>
  </template>
</section>

<script>
  import { CUES } from '../data/cues';
  import { getRecent } from '../utils/storage';

  const SHOWN = 10;

  function render() {
    const section = document.querySelector<HTMLElement>('[data-recent]');
    const list = section?.querySelector('[data-recent-list]');
    const template =
      section?.querySelector<HTMLTemplateElement>('[data-recent-item]');
    if (!section || !list || !template) return;

    const cues = getRecent()
      .slice(-SHOWN)
      .reverse()
      .map((id) => CUES.find((c) => c.id === id))
      .filter((c) => c !== undefined);

    list.replaceChildren(
      ...cues.map((cue) => {
        const item = template.content.cloneNode(true) as DocumentFragment;
        const link = item.querySelector('a')!;
        link.href = `/cue/${cue.slug}/`;
        link.dataset.suit = cue.suit;
        item.querySelector('use')!.setAttribute('href', `#glyph-${cue.suit}`);
        item.querySelector('span')!.textContent = cue.text;
        return item;
      }),
    );
    section.classList.toggle('hidden', cues.length === 0);
  }

  render();
  document.addEventListener('recent:change', render);
</script>
