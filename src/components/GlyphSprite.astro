---
/**
 * Inline SVG sprite with one symbol per suit, referenced by SuitGlyph via
 * `<use href="#glyph-…">`. Lets client scripts swap a card's suit by changing
 * a single attribute.
 */
---

<svg width="0" height="0" class="absolute" aria-hidden="true">
  <defs>
    <symbol id="glyph-reframe" viewBox="0 0 24 24">
      <path d="M12 2.5 21.5 12 12 21.5 2.5 12Z"></path>
    </symbol>
    <symbol id="glyph-subtract" viewBox="0 0 24 24">
      <rect x="2.5" y="9" width="19" height="6" rx="3"></rect>
    </symbol>
    <symbol id="glyph-structure" viewBox="0 0 24 24">
      <rect x="4" y="4" width="16" height="16" rx="2.5"></rect>
    </symbol>
    <symbol id="glyph-act" viewBox="0 0 24 24">
      <path d="M10.27 4.1a2 2 0 0 1 3.46 0l7.8 13.4A2 2 0 0 1 19.8 20.5H4.2a2 2 0 0 1-1.73-3l7.8-13.4Z"></path>
    </symbol>
    <symbol id="glyph-pace" viewBox="0 0 24 24">
      <path d="M2.5 17a9.5 9.5 0 0 1 19 0 1.5 1.5 0 0 1-1.5 1.5H4A1.5 1.5 0 0 1 2.5 17Z"></path>
    </symbol>
    <symbol id="glyph-feel" viewBox="0 0 24 24">
      <circle cx="12" cy="12" r="9"></circle>
    </symbol>
    <symbol id="glyph-resource" viewBox="0 0 24 24">
      <path d="M9.5 3.5a1 1 0 0 1 1-1h3a1 1 0 0 1 1 1v6h6a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1h-6v6a1 1 0 0 1-1 1h-3a1 1 0 0 1-1-1v-6h-6a1 1 0 0 1-1-1v-3a1 1 0 0 1 1-1h6Z"></path>
    </symbol>
  </defs>
</svg>
